{
	"schemaVersion": 1,
	"pluginId": "cn.mcd7.neglectdream.dsh-pet",
	"version": "2.2.0",
	"displayName": "DSH Pet",
	"description": "一只住在 NarraFork 面板里的蓝色大肥鱼：114 段全透明动画、拖拽甩抛、点击 Q 弹、多只同屏互撞，还会按余额档位演戏。",
	"publisher": {
		"id": "neglectdream",
		"name": "NeglectDream"
	},
	"license": "MIT",
	"engine": {
		"runtime": "bun",
		"runtimeVersion": ">=1.2 <2",
		"hostApi": ">=1.0 <2",
		"rpc": "narrafork.rpc/1",
		"features": ["host_api.requests"],
		"os": ["win32", "linux", "darwin"],
		"arch": ["x64", "arm64"],
		"runner": "local-process"
	},
	"server": {
		"entry": "server/index.js",
		"transport": "stdio",
		"protocol": "narrafork.rpc/1",
		"args": [],
		"workingDirectory": "package",
		"startupTimeoutMs": 15000,
		"activationTimeoutMs": 30000
	},
	"activationEvents": [
		"onView:pet-stage",
		"onView:pet-settings",
		"onCommand:pet-state",
		"onCommand:pet-config-get",
		"onCommand:pet-config-set",
		"onCommand:pet-balance-refresh",
		"onCommand:pet-clip",
		"onCommand:pet-secrets-list",
		"onCommand:pet-log",
		"onCommand:pet-ledger-get",
		"onCommand:pet-ledger-correct",
		"onCommand:pet-notices"
	],
	"ui": {
		"entry": "ui/stage.iife.js",
		"format": "iife",
		"style": "ui/stage.bundle.css",
		"shell": "host-controlled"
	},
	"contributes": {
		"providers": [],
		"searchProviders": [],
		"tools": [],
		"events": [],
		"themes": [],
		"commands": [
			{
				"id": "pet-ledger-get", "title": "读取观测账本", "handler": "server",
				"description": "按账户和币种返回真实观测区间；不消耗提醒。",
				"inputSchema": { "type": "object", "additionalProperties": false, "properties": {
					"accountId": { "type": "string", "maxLength": 160 },
					"days": { "type": "integer", "minimum": 1, "maximum": 31 }, "audit": { "type": "boolean" }
				} }
			},
			{
				"id": "pet-ledger-correct", "title": "确认或撤销账本校正", "handler": "server",
				"description": "要求明确确认与当前 revision，冲突时拒绝覆盖新观测。",
				"inputSchema": { "type": "object", "additionalProperties": false, "required": ["action", "accountId", "revision", "confirmed"], "properties": {
					"action": { "type": "string", "enum": ["set", "undo"] },
					"accountId": { "type": "string", "maxLength": 160 }, "revision": { "type": "integer", "minimum": 0 },
					"confirmed": { "type": "boolean", "const": true }, "confirmedTopUp": { "type": ["string", "number"] },
					"nonUsageDebit": { "type": ["string", "number"] }, "correctionId": { "type": "string", "maxLength": 100 },
					"note": { "type": "string", "maxLength": 300 }
				} }
			},
			{
				"id": "pet-notices", "title": "领取或确认提醒", "handler": "server",
				"description": "有界租约领取，仅实际可见展示后确认，多视图共用持久闩锁。",
				"inputSchema": { "type": "object", "additionalProperties": false, "required": ["action", "consumerId"], "properties": {
					"action": { "type": "string", "enum": ["claim", "ack"] }, "consumerId": { "type": "string", "maxLength": 100 },
					"limit": { "type": "integer", "minimum": 1, "maximum": 5 }, "id": { "type": "string", "maxLength": 100 },
					"leaseToken": { "type": "string", "maxLength": 100 },
					"accountIds": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "pattern": "^acct_[a-f0-9]{40}$" } }
				} }
			},
			{
				"id": "pet-state",
				"title": "读取桌宠状态",
				"description": "一次调用返回配置、余额快照与运行态，供舞台轮询。",
				"handler": "server"
			},
			{
				"id": "pet-config-get",
				"title": "读取桌宠配置",
				"handler": "server"
			},
			{
				"id": "pet-config-set",
				"title": "写入桌宠配置",
				"description": "深合并到现有配置并返回合并后的完整配置。",
				"handler": "server",
				"inputSchema": {
					"type": "object",
					"additionalProperties": false,
					"properties": {
						"patch": { "type": "object" },
						"reset": { "type": "boolean" }
					}
				}
			},
			{
				"id": "pet-balance-refresh",
				"title": "刷新余额",
				"description": "强制查询一次余额。authoritative=false 表示沿用缓存。",
				"handler": "server",
				"inputSchema": {
					"type": "object",
					"additionalProperties": false,
					"properties": {
						"providerId": { "type": "string", "maxLength": 64 },
						"force": { "type": "boolean" }
					}
				}
			},
			{
				"id": "pet-clip",
				"title": "读取动画片段字节",
				"description": "按分片返回一段动画的原始字节（base64）。宿主只服务 manifest 声明过的资源路径，所以图片数据走命令通道交给 UI 组装成 Blob URL。",
				"handler": "server",
				"inputSchema": {
					"type": "object",
					"additionalProperties": false,
					"required": ["index"],
					"properties": {
						"index": { "type": "integer", "minimum": 0, "maximum": 999 },
						"offset": { "type": "integer", "minimum": 0 },
						"length": { "type": "integer", "minimum": 1, "maximum": 1048576 }
					}
				}
			},
			{
				"id": "pet-secrets-list",
				"title": "已配置密钥",
				"description": "返回哪些密钥已配置，永不返回值。",
				"handler": "server"
			},
			{
				"id": "pet-log",
				"title": "桌宠日志上报",
				"description": "UI 侧异常上报到插件 stderr，便于诊断。",
				"handler": "server",
				"inputSchema": {
					"type": "object",
					"additionalProperties": false,
					"required": ["level", "message"],
					"properties": {
						"level": { "type": "string", "enum": ["info", "warn", "error"] },
						"message": { "type": "string", "maxLength": 2000 },
						"detail": { "type": "object" }
					}
				}
			}
		],
		"views": [
			{
				"id": "pet-stage",
				"title": "桌宠",
				"entry": "ui/stage.iife.js",
				"style": "ui/stage.bundle.css",
				"surfaces": ["workspace", "focus", "director", "overlay"],
				"scope": "global",
				"instance": "singleton",
				"defaultPosition": "bottom"
			},
			{
				"id": "pet-settings",
				"title": "桌宠设置",
				"entry": "ui/settings.iife.js",
				"style": "ui/settings.bundle.css",
				"surfaces": ["settings", "workspace", "focus", "director"],
				"scope": "global",
				"instance": "singleton",
				"runtime": "host-react"
			}
		]
	},
	"permissions": {
		"host": [
			"ui.panel",
			"storage.read_self",
			"storage.write_self",
			"secret.use_self",
			"diagnostics.readOwnLogs",
			"event.subscribe"
		],
		"network": {
			"mode": "allowlist",
			"allow": []
		},
		"filesystem": {
			"package": "readOnly",
			"pluginData": "none",
			"workspace": "none"
		},
		"process": {
			"spawn": "none"
		}
	},
	"secrets": [
		{
			"id": "customApiKey",
			"label": "第三方余额 API Key",
			"required": false,
			"scope": ["user"],
			"usage": "outbound-network",
			"inject": "ephemeral-reference"
		}
	],
	"dependencies": {
		"plugins": {},
		"runtime": {}
	}
}
